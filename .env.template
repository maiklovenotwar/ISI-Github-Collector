# GitHub API Konfiguration
# Einzelnes Token
GITHUB_API_TOKEN=dein_github_token_hier

# Alternativ: Mehrere Tokens durch Kommas getrennt für höhere Rate Limits
# GITHUB_API_TOKENS=token1,token2,token3

# Datenbank-Konfiguration
DATABASE_URL=sqlite:///github_data.db

# Geocoding-Konfiguration
# Optional: API-Schlüssel für externe Geocoding-Dienste
# GEOCODING_API_KEY=dein_geocoding_api_key_hier

# Cache-Konfiguration
CACHE_DIR=.github_cache
CACHE_ENABLED=true

# Oracle Orbis
ORBIS_HOST=x
ORBIS_PORT=1521
ORBIS_SERVICE=x
ORBIS_USER=x
ORBIS_PASSWORD=x
ORBIS_SCHEMA=ORBIS_23J

# Lokaler LLM-Server (workstreams/entity_classification/scripts/evaluate_llms_on_goldstandard.py)
# OpenAI-kompatible Basis-URL (ohne /chat/completions-Suffix), z. B. LM Studio
LOCAL_LLM_URL=http://localhost:1234/v1

# Gehostetes LLM-Gateway (OpenAI-kompatibel, Bearer-Token) für dasselbe Skript
FREE_LLMS=dein_token_hier
FREE_LLMS_URL=https://llm-gateway.example.org/v1